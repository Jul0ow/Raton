{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raton:schema:plateforme:v0",
  "title": "Plateforme",
  "description": "La plateforme est l'ensemble des services communs que l'équipe infra fournit à toutes les applications qu'elle héberge : points d'entrée des utilisateurs, SSO, gestionnaire de secrets, journalisation, supervision, DNS. Ce fichier dit où ils se trouvent et comment le cluster filtre le réseau (CNI, étiquette des composants, proxy sortant), pour générer les politiques réseau. Tenu par l'équipe infra, commun à toutes les applications.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cni", "etiquette_composant", "dns", "services"],
  "properties": {
    "format": { "const": "raton/plateforme/v0" },
    "cni": {
      "enum": ["cilium", "standard"],
      "description": "cilium : les destinations désignées par un nom sont filtrées par CiliumNetworkPolicy (toFQDNs). standard : NetworkPolicy seules, qui ne connaissent que des sélecteurs et des blocs d'adresses ; les destinations par nom passent alors par le proxy sortant."
    },
    "etiquette_composant": {
      "$ref": "#/$defs/cle_etiquette",
      "description": "Étiquette qui porte, sur chaque pod, le nom de son composant ou de son stockage, tel que le donne la partie technique (api, worker, postgres)."
    },
    "dns": { "$ref": "#/$defs/dans_le_cluster", "description": "DNS du cluster, toujours autorisé." },
    "proxy_sortant": {
      "description": "Proxy par lequel passent les destinations désignées par un nom, quand le CNI ne sait pas les filtrer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "pods", "port"],
      "properties": {
        "namespace": { "$ref": "#/$defs/namespace" },
        "pods": { "$ref": "#/$defs/selecteur" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entree_interne": { "$ref": "#/$defs/emplacement" },
        "entree_externe": { "$ref": "#/$defs/emplacement" },
        "sso": { "$ref": "#/$defs/emplacement" },
        "secrets": { "$ref": "#/$defs/emplacement" },
        "journalisation": { "$ref": "#/$defs/emplacement" },
        "supervision": { "$ref": "#/$defs/emplacement" }
      }
    }
  },

  "$defs": {
    "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "cle_etiquette": {
      "type": "string",
      "maxLength": 316,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    },
    "selecteur": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/cle_etiquette" },
      "additionalProperties": { "type": "string", "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$" }
    },
    "dans_le_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "pods"],
      "properties": {
        "namespace": { "$ref": "#/$defs/namespace" },
        "pods": { "$ref": "#/$defs/selecteur" }
      }
    },
    "emplacement": {
      "description": "Dans le cluster (namespace et étiquettes des pods), ou hors du cluster, par noms DNS ou par blocs d'adresses.",
      "oneOf": [
        { "$ref": "#/$defs/dans_le_cluster" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hotes"],
          "properties": {
            "hotes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:raton:schema:flux:v0#/$defs/hote" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidrs"],
          "properties": {
            "cidrs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:raton:schema:flux:v0#/$defs/cidr" } }
          }
        }
      ]
    }
  }
}
