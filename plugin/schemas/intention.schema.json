{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raton:schema:intention:v0",
  "title": "DAT, partie intention",
  "description": "Ce que l'application doit faire, en langage métier. Rédigée ou validée par le métier sans partir du code. Référence de la revue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "application", "profils", "donnees", "fonctions", "echanges", "exclusions"],
  "properties": {
    "format": { "const": "raton/intention/v0" },

    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom", "objet", "porteur"],
      "properties": {
        "nom": { "$ref": "#/$defs/texte_court" },
        "objet": { "$ref": "#/$defs/texte_long", "description": "Le besoin couvert, en quelques phrases." },
        "porteur": { "$ref": "#/$defs/personne" }
      }
    },

    "profils": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "libelle", "population"],
        "properties": {
          "id": { "$ref": "#/$defs/id_profil" },
          "libelle": { "$ref": "#/$defs/texte_court" },
          "population": { "enum": ["interne", "externe"] },
          "effectif": { "type": "integer", "minimum": 1, "description": "Ordre de grandeur." }
        }
      }
    },

    "donnees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "libelle", "origine", "personnelles", "conservation"],
        "properties": {
          "id": { "$ref": "#/$defs/id_donnee" },
          "libelle": { "$ref": "#/$defs/texte_court" },
          "origine": { "$ref": "#/$defs/texte_court" },
          "personnelles": {
            "enum": ["non", "oui", "sensibles"],
            "description": "sensibles : catégories particulières au sens de l'article 9 du RGPD (santé, opinions, etc.)."
          },
          "conservation": { "$ref": "#/$defs/texte_court" }
        }
      }
    },

    "fonctions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "libelle", "donnees"],
        "anyOf": [
          { "required": ["profils"], "properties": { "profils": { "minItems": 1 } } },
          { "required": ["declencheur"] }
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id_fonction" },
          "libelle": { "$ref": "#/$defs/texte_court" },
          "profils": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id_profil" } },
          "declencheur": { "$ref": "#/$defs/texte_court", "description": "Pour une fonction automatique : ce qui la déclenche." },
          "donnees": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "lit": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id_donnee" } },
              "ecrit": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id_donnee" } }
            }
          },
          "echanges": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id_echange" } }
        }
      }
    },

    "echanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "partenaire", "sens", "donnees", "motif"],
        "properties": {
          "id": { "$ref": "#/$defs/id_echange" },
          "partenaire": { "$ref": "#/$defs/texte_court" },
          "interconnexions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^I[0-9]{2}$" },
            "description": "Interconnexions de la fiche de qualification par lesquelles passe l'échange. Facultatif pour le schéma ; qualification.py signale un échange qui n'en cite aucune."
          },
          "sens": {
            "enum": ["recoit", "envoie", "les_deux"],
            "description": "Sens des données, vu de l'application. Le sens des connexions est porté par la matrice de flux."
          },
          "donnees": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id_donnee" } },
          "motif": { "$ref": "#/$defs/texte_court" }
        }
      }
    },

    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "libelle"],
        "properties": {
          "id": { "$ref": "#/$defs/id_exclusion" },
          "libelle": { "$ref": "#/$defs/texte_court" }
        }
      }
    },

    "validation": {
      "description": "Absente tant que le métier n'a pas validé : l'intention est alors un brouillon, inutilisable par la revue.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "redige_par", "valide_par", "date", "redige_sans_le_code"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "redige_par": { "$ref": "#/$defs/texte_court" },
        "valide_par": { "$ref": "#/$defs/texte_court" },
        "date": { "$ref": "#/$defs/date" },
        "redige_sans_le_code": {
          "const": true,
          "description": "Attestation du valideur : l'intention a été rédigée sans partir du code."
        }
      }
    }
  },

  "$defs": {
    "texte_court": { "type": "string", "minLength": 1, "maxLength": 200 },
    "texte_long": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "personne": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom", "entite"],
      "properties": {
        "nom": { "$ref": "#/$defs/texte_court" },
        "entite": { "$ref": "#/$defs/texte_court" }
      }
    },
    "id_profil": { "type": "string", "pattern": "^P[0-9]{2}$" },
    "id_donnee": { "type": "string", "pattern": "^D[0-9]{2}$" },
    "id_fonction": { "type": "string", "pattern": "^F[0-9]{2}$" },
    "id_echange": { "type": "string", "pattern": "^E[0-9]{2}$" },
    "id_exclusion": { "type": "string", "pattern": "^X[0-9]{2}$" }
  }
}
